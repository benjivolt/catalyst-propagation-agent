# Leave OPENAI_API_KEY empty to use the rule-based analyzer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_HEALTHCHECK_MODEL=gpt-5.5
OPENAI_MODEL_FALLBACKS=gpt-5.2,gpt-5.4-mini,gpt-4.1-mini
OPENAI_STRICT_ANALYSIS=false
OPENAI_INPUT_COST_PER_1M=0
OPENAI_OUTPUT_COST_PER_1M=0

# Set APP_PASSWORD before exposing the app beyond localhost (HTTP basic auth, any username).
APP_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_PATH=./catalyst_propagation.db
SEC_USER_AGENT="CatalystPropagationAgent/1.0 your-email@example.com"
SCRAPERAPI_API_KEY=
REQUEST_TIMEOUT_SECONDS=15
SOURCE_CACHE_TTL_SECONDS=1800
SOURCE_FETCH_RETRIES=3
SOURCE_RETRY_BASE_SLEEP_SECONDS=0.25
SOURCE_VERIFICATION_FETCH_ON_ANALYZE=false
SOURCE_VERIFICATION_TIMEOUT_SECONDS=5

ADAPTIVE_SCHEDULER_AUTOSTART=true
EXTERNAL_SCHEDULER_WORKER=false
SCHEDULER_TICK_SECONDS=60
SCHEDULER_DAILY_BUDGET_USD=2.50
SCHEDULER_CANDIDATE_THRESHOLD=0.62
SCHEDULER_LLM_THRESHOLD=0.72
ADAPTIVE_MIN_CHECK_MINUTES=15
ADAPTIVE_MAX_CHECK_HOURS=24
ADAPTIVE_MAX_JOBS_PER_TICK=8

ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
